diff --git a/packages/duckdb-wasm/test/superhuman_docs.test.ts b/packages/duckdb-wasm/test/superhuman_docs.test.ts
new file mode 100644
index 0000000..a66f461
--- /dev/null
+++ b/packages/duckdb-wasm/test/superhuman_docs.test.ts
@@ -0,0 +1,91 @@
+import * as duckdb from '../src/targets/duckdb';
+
+type RecordedRequest = { method: string; path: string; query: string; body: string };
+
+const sqlString = (value: string): string => `'${value.replace(/'/g, "''")}'`;
+
+export function testSuperhumanDocs(adb: () => duckdb.AsyncDuckDB): void {
+    describe('Superhuman Docs built-in extension', () => {
+        const apiBase = `${window.location.origin}/superhuman-docs-api`;
+
+        beforeEach(async () => {
+            await fetch(`${apiBase}/__requests`, { method: 'DELETE' });
+            await adb().open({ path: ':memory:' });
+        });
+
+        it('attaches, scans pagination, polls mutations, and preserves DELETE JSON', async () => {
+            const conn = await adb().connect();
+            await conn.query(
+                `ATTACH 'mock-doc' AS superhuman_docs_doc (` +
+                    `TYPE superhuman_docs, TOKEN 'mock-token', API_BASE ${sqlString(apiBase)}, ` +
+                    `WAIT_FOR_MUTATIONS true, MUTATION_TIMEOUT_SECONDS 5);`,
+            );
+            const rows = await conn.query(`SELECT "Name" FROM superhuman_docs_doc.main."Tasks" ORDER BY "Name"`);
+            expect(rows.toArray().map(row => row.Name)).toEqual(['Alpha', 'Beta']);
+            await conn.query(
+                `INSERT INTO superhuman_docs_doc.main."Tasks" ("Name", "Done", "Amount") ` +
+                    `VALUES ('Gamma', false, 3.5)`,
+            );
+            await conn.query(
+                `UPDATE superhuman_docs_doc.main."Tasks" SET "Done" = false, "Amount" = 4.5 ` +
+                    `WHERE "Name" = 'Alpha'`,
+            );
+            await conn.query(`DELETE FROM superhuman_docs_doc.main."Tasks" WHERE "Name" = 'Beta'`);
+
+            const requests = (await (await fetch(`${apiBase}/__requests`)).json()) as RecordedRequest[];
+            expect(requests.some(req => req.method === 'GET' && req.query.includes('pageToken=page-2'))).toBeTrue();
+            expect(requests.some(req => req.path === '/mutationStatus/delete-request')).toBeTrue();
+            const deletion = requests.find(
+                req => req.method === 'DELETE' && req.path === '/docs/mock-doc/tables/tbl1/rows',
+            );
+            expect(deletion).toBeDefined();
+            expect(JSON.parse(deletion!.body).rowIds).toEqual(['r2']);
+
+            await conn.close();
+        });
+
+        it('surfaces HTTP and network/CORS errors and remains usable', async () => {
+            const conn = await adb().connect();
+            await expectAsync(
+                conn.query(
+                    `ATTACH 'error-doc' AS broken (` +
+                        `TYPE superhuman_docs, TOKEN 'mock-token', API_BASE ${sqlString(apiBase)});`,
+                ),
+            ).toBeRejectedWithError(/503|mock failure/);
+            await expectAsync(
+                conn.query(
+                    `ATTACH 'mock-doc' AS unreachable (` +
+                        `TYPE superhuman_docs, TOKEN 'mock-token', API_BASE 'http://127.0.0.1:1');`,
+                ),
+            ).toBeRejected();
+            const corsBase = `http://127.0.0.1:${window.location.port}/superhuman-docs-api/cors`;
+            await expectAsync(
+                conn.query(
+                    `ATTACH 'mock-doc' AS cors_rejected (` +
+                        `TYPE superhuman_docs, TOKEN 'mock-token', API_BASE ${sqlString(corsBase)});`,
+                ),
+            ).toBeRejected();
+            const result = await conn.query('SELECT 42 AS answer');
+            expect(result.toArray()[0].answer).toEqual(42);
+            await conn.close();
+        });
+
+        it('enforces the 30-second transport timeout and remains usable', async () => {
+            const conn = await adb().connect();
+            const started = performance.now();
+            await expectAsync(
+                conn.query(
+                    `ATTACH 'slow-doc' AS timed_out (` +
+                        `TYPE superhuman_docs, TOKEN 'mock-token', ` +
+                        `API_BASE ${sqlString(`${apiBase}/slow`)});`,
+                ),
+            ).toBeRejected();
+            const elapsed = performance.now() - started;
+            expect(elapsed).toBeGreaterThanOrEqual(29000);
+            expect(elapsed).toBeLessThan(35000);
+            const result = await conn.query('SELECT 42 AS answer');
+            expect(result.toArray()[0].answer).toEqual(42);
+            await conn.close();
+        });
+    });
+}
