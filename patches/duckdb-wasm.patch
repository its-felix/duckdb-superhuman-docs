diff --git a/packages/duckdb-wasm/karma/superhuman_docs_mock.cjs b/packages/duckdb-wasm/karma/superhuman_docs_mock.cjs
new file mode 100644
index 0000000..545244e
--- /dev/null
+++ b/packages/duckdb-wasm/karma/superhuman_docs_mock.cjs
@@ -0,0 +1,132 @@
+const requests = [];
+const occurrences = new Map();
+
+function json(res, status, body, cors = true) {
+    const payload = JSON.stringify(body);
+    const headers = {
+        'Content-Type': 'application/json',
+        'Content-Length': Buffer.byteLength(payload),
+    };
+    if (cors) {
+        headers['Access-Control-Allow-Origin'] = '*';
+        headers['Access-Control-Allow-Headers'] = 'Authorization, Content-Type';
+        headers['Access-Control-Allow-Methods'] = 'GET, POST, PUT, PATCH, DELETE, OPTIONS';
+    }
+    res.writeHead(status, headers);
+    res.end(payload);
+}
+
+function responseFor(method, pathname, search, body) {
+    const key = `${method} ${pathname}`;
+    const occurrence = (occurrences.get(key) || 0) + 1;
+    occurrences.set(key, occurrence);
+
+    if (method === 'GET' && pathname === '/whoami') return [200, { name: 'Browser Test' }];
+    if (method === 'GET' && pathname === '/docs/error-doc/tables') return [503, { message: 'mock failure' }];
+    if (method === 'GET' && pathname === '/docs/mock-doc/tables') {
+        return [200, { items: [{ id: 'tbl1', name: 'Tasks', tableType: 'table' }] }];
+    }
+    if (method === 'GET' && pathname === '/docs/mock-doc/tables/tbl1/columns') {
+        return [
+            200,
+            {
+                items: [
+                    { id: 'c_name', name: 'Name', calculated: false, format: { type: 'text', isArray: false } },
+                    { id: 'c_done', name: 'Done', calculated: false, format: { type: 'checkbox', isArray: false } },
+                    { id: 'c_amount', name: 'Amount', calculated: false, format: { type: 'number', isArray: false } },
+                ],
+            },
+        ];
+    }
+    if (method === 'GET' && pathname === '/docs/mock-doc/tables/tbl1/rows') {
+        if (search.has('syncToken')) return [200, { items: [] }];
+        if (search.has('pageToken')) {
+            return [
+                200,
+                {
+                    items: [{ id: 'r2', values: { c_name: 'Beta', c_done: false, c_amount: 2.5 } }],
+                    nextSyncToken: 'done',
+                },
+            ];
+        }
+        const query = search.get('query') || '';
+        if (query.includes('Alpha')) {
+            return [
+                200,
+                {
+                    items: [{ id: 'r1', values: { c_name: 'Alpha', c_done: true, c_amount: 1.25 } }],
+                    nextSyncToken: 'done',
+                },
+            ];
+        }
+        if (query.includes('Beta')) {
+            return [
+                200,
+                {
+                    items: [{ id: 'r2', values: { c_name: 'Beta', c_done: false, c_amount: 2.5 } }],
+                    nextSyncToken: 'done',
+                },
+            ];
+        }
+        return [
+            200,
+            {
+                items: [{ id: 'r1', values: { c_name: 'Alpha', c_done: true, c_amount: 1.25 } }],
+                nextPageToken: 'page-2',
+            },
+        ];
+    }
+    if (method === 'POST' && pathname === '/docs/mock-doc/tables/tbl1/rows') {
+        return [202, { requestId: 'insert-request', addedRowIds: ['new-row'] }];
+    }
+    if (method === 'PUT' && pathname === '/docs/mock-doc/tables/tbl1/rows/r1') {
+        return [202, { requestId: 'update-request', id: 'r1' }];
+    }
+    if (method === 'DELETE' && pathname === '/docs/mock-doc/tables/tbl1/rows') {
+        return [202, { requestId: 'delete-request', rowIds: ['r2'] }];
+    }
+    if (method === 'GET' && pathname.startsWith('/mutationStatus/')) {
+        if (occurrence === 1) return [200, { completed: false }];
+        return [200, { completed: true }];
+    }
+    if (method === 'GET' && pathname === '/slow/whoami') return [200, { name: body }];
+    return [404, { message: `unexpected mock request ${method} ${pathname}` }];
+}
+
+function factory() {
+    return function superhumanDocsMock(req, res, next) {
+        res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+        res.setHeader('Cross-Origin-Embedder-Policy', 'require-corp');
+        if (!req.url.startsWith('/superhuman-docs-api')) return next();
+
+        const url = new URL(req.url, 'http://localhost');
+        const pathname = url.pathname.slice('/superhuman-docs-api'.length) || '/';
+        if (pathname === '/__requests') {
+            if (req.method === 'DELETE') {
+                requests.length = 0;
+                occurrences.clear();
+                return json(res, 200, { ok: true });
+            }
+            return json(res, 200, requests);
+        }
+        if (req.method === 'OPTIONS') return json(res, 204, {});
+
+        const chunks = [];
+        req.on('data', chunk => chunks.push(chunk));
+        req.on('end', () => {
+            const body = Buffer.concat(chunks).toString('utf8');
+            requests.push({ method: req.method, path: pathname, query: url.search.slice(1), body });
+            if (pathname.startsWith('/cors/')) {
+                return json(res, 200, { items: [] }, false);
+            }
+            if (pathname === '/slow/docs/slow-doc/tables') {
+                return setTimeout(() => json(res, 200, { items: [] }), 31000);
+            }
+            const [status, payload] = responseFor(req.method, pathname, url.searchParams, body);
+            json(res, status, payload);
+        });
+    };
+}
+
+factory.$inject = [];
+module.exports = ['factory', factory];
